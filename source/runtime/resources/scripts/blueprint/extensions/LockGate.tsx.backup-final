import React, { ReactNode, useEffect, useState } from 'react';
import http from '@/api/http';

interface LockGateProps {
    serverId: string;
    children: ReactNode;
}

const getStatus = async (serverId: string) => {
    console.log('[ServerLock] SERVER ID YANG DITERIMA:', serverId);
    const url = `/api/client/extensions/serverlock/status/${encodeURIComponent(serverId)}`;

    console.log('[ServerLock] CHECK STATUS:', url);

    const response = await http.get(url);

    console.log('[ServerLock] STATUS RESPONSE:', {
        status: response.status,
        data: response.data,
        serverId,
    });

    return response.data?.locked === true;
};

const verifyPassword = async (serverId: string, password: string) => {
    const url = `/api/client/extensions/serverlock/verify/${encodeURIComponent(serverId)}`;

    console.log('[ServerLock] VERIFY:', url);

    const response = await http.post(url, {
        password,
    });

    console.log('[ServerLock] VERIFY RESPONSE:', {
        status: response.status,
        data: response.data,
    });

    return response.data?.valid === true;
};

export default ({ serverId, children }: LockGateProps) => {
    const [checking, setChecking] = useState(true);
    const [locked, setLocked] = useState(false);
    const [password, setPassword] = useState('');
    const [error, setError] = useState('');
    const [submitting, setSubmitting] = useState(false);

    useEffect(() => {
        let cancelled = false;

        const check = async () => {
            setChecking(true);
            setError('');

            try {
                const isLocked = await getStatus(serverId);

                if (cancelled) return;

                console.log('[ServerLock] FINAL LOCK STATE:', {
                    serverId,
                    locked: isLocked,
                });

                setLocked(isLocked);
            } catch (err: any) {
                if (cancelled) return;

                console.error('[ServerLock] STATUS ERROR:', err);

                /*
                 * Saat debugging, API error JANGAN dianggap unlocked.
                 * Kalau endpoint gagal, tampilkan error agar masalah
                 * tidak diam-diam melewati lock.
                 */
                setLocked(true);
                setError(
                    err?.response?.data?.message ||
                    err?.message ||
                    'Gagal memeriksa status server.'
                );
            } finally {
                if (!cancelled) {
                    setChecking(false);
                }
            }
        };

        check();

        return () => {
            cancelled = true;
        };
    }, [serverId]);

    const submit = async () => {
        if (!password || submitting) return;

        setSubmitting(true);
        setError('');

        try {
            const valid = await verifyPassword(serverId, password);

            if (valid) {
                console.log('[ServerLock] PASSWORD BENAR');

                setLocked(false);
                setPassword('');
            } else {
                console.log('[ServerLock] PASSWORD SALAH');

                setError('Password salah.');
                setPassword('');
            }
        } catch (err: any) {
            console.error('[ServerLock] VERIFY ERROR:', err);

            if (err?.response?.status === 401) {
                setError('Password salah.');
            } else {
                setError(
                    err?.response?.data?.message ||
                    err?.message ||
                    'Gagal menghubungi server.'
                );
            }

            setPassword('');
        } finally {
            setSubmitting(false);
        }
    };

    if (checking) {
        return null;
    }

    if (!locked) {
        return <>{children}</>;
    }

    return (
        <div
            style={{
                position: 'fixed',
                inset: 0,
                zIndex: 999999,
                background: 'rgba(0, 0, 0, 0.97)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                padding: '24px',
                boxSizing: 'border-box',
            }}
        >
            <div
                style={{
                    width: '100%',
                    maxWidth: '420px',
                    background: '#111',
                    border: '1px solid #333',
                    borderRadius: '12px',
                    padding: '32px',
                    boxSizing: 'border-box',
                    textAlign: 'center',
                    color: '#fff',
                    boxShadow: '0 20px 60px rgba(0,0,0,.7)',
                }}
            >
                <div
                    style={{
                        fontSize: '42px',
                        marginBottom: '12px',
                    }}
                >
                    🔒
                </div>

                <h2
                    style={{
                        margin: '0 0 10px',
                        fontSize: '22px',
                    }}
                >
                    Server Terkunci
                </h2>

                <p
                    style={{
                        color: '#aaa',
                        margin: '0 0 20px',
                        fontSize: '14px',
                    }}
                >
                    Masukkan password untuk mengakses server ini.
                </p>

                {error && (
                    <div
                        style={{
                            color: '#ff6b6b',
                            fontSize: '13px',
                            marginBottom: '12px',
                            padding: '10px',
                            background: 'rgba(255,107,107,.08)',
                            borderRadius: '8px',
                        }}
                    >
                        {error}
                    </div>
                )}

                <input
                    type="password"
                    value={password}
                    autoFocus
                    disabled={submitting}
                    onChange={(e) => setPassword(e.target.value)}
                    onKeyDown={(e) => {
                        if (e.key === 'Enter') {
                            submit();
                        }
                    }}
                    placeholder="Password server"
                    style={{
                        width: '100%',
                        boxSizing: 'border-box',
                        padding: '12px 14px',
                        borderRadius: '8px',
                        border: '1px solid #444',
                        background: '#080808',
                        color: '#fff',
                        outline: 'none',
                        fontSize: '15px',
                        textAlign: 'center',
                        marginBottom: '12px',
                    }}
                />

                <button
                    type="button"
                    onClick={submit}
                    disabled={submitting || !password}
                    style={{
                        width: '100%',
                        padding: '12px 16px',
                        borderRadius: '8px',
                        border: 'none',
                        background:
                            submitting || !password ? '#555' : '#fff',
                        color: '#000',
                        fontWeight: 700,
                        fontSize: '14px',
                        cursor:
                            submitting || !password
                                ? 'not-allowed'
                                : 'pointer',
                    }}
                >
                    {submitting ? 'Memeriksa...' : 'Buka Server'}
                </button>
            </div>
        </div>
    );
};
